# Copy this file to .env and put your real password in .env.
# .env is ignored by Git; this example file is committed.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/port_logistics

# Read-only login for SQL written by the NL assistant (see database/roles.sql).
# Set its password once in pgAdmin:  ALTER ROLE nl_assistant PASSWORD '...';
NL_DATABASE_URL=postgresql://nl_assistant:NL_PASSWORD@localhost:5432/port_logistics

# Local LLM (Ollama).  qwen2.5:7b fits fully in an 8 GB GPU.
OLLAMA_URL=http://127.0.0.1:11434

# Signs login tokens.  Any long random string; keep it secret.  If missing, a random
# one is made at start-up and every restart logs everybody out.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
OLLAMA_MODEL=qwen2.5:7b
